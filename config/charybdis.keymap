#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp GRAVE   &kp N1   &kp N2  &kp N3        &kp N4     &kp N5        &kp N6     &kp N7     &kp N8     &kp N9   &kp N0       &kp MINUS
&kp ESC     &kp Q    &kp W   &kp E         &kp R      &kp T         &kp Y      &kp U      &kp I      &kp O    &kp P        &kp BACKSPACE
&kp TAB     &kp A    &kp S   &kp D         &kp F      &kp G         &kp H      &kp J      &kp K      &kp L    &kp SEMI     &kp APOS
&kp LSHIFT  &lt 3 Z  &kp X   &kp C         &kp V      &kp B         &kp N      &kp M      &kp COMMA  &kp DOT  &lt 3 SLASH  &kp EQUAL
                             &kp LEFT_GUI  &kp LALT   &tog 1        &tog 2     &kp SPACE
                                           &kp LCTRL  &kp DELETE    &kp ENTER
            >;
        };

        Lower {
            bindings = <
&kp TILDE   &kp EXCLAMATION  &kp HASH      &kp DOLLAR    &kp DOLLAR    &kp PERCENT     &kp CARET      &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE
&kp GRAVE   &kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp LBKT        &kp RBKT       &kp F1         &kp F2        &kp F3                &kp F4                 &kp BACKSPACE
&kp TAB     &kp NUMBER_5     &kp NUMBER_6  &kp NUMBER_7  &kp NUMBER_8  &none           &kp BACKSLASH  &kp F5         &kp F6        &kp F7                &kp F8                 &kp PAGE_UP
&kp LSHIFT  &kp NUMBER_9     &kp NUMBER_0  &kp MINUS     &kp EQUAL     &none           &none          &kp F9         &kp F10       &kp F11               &kp F12                &kp PAGE_DOWN
                                           &trans        &kp LEFT_ALT  &kp LEFT_WIN    &kp ENTER      &kp SPACE
                                                         &kp LCTRL     &kp INS         &kp DELETE
            >;
        };

        Raise {
            bindings = <
&kp F12        &kp F1      &kp F2      &kp F3         &kp F4         &kp F5          &kp F6             &kp F7     &kp F8    &kp F9     &kp F10  &kp F11
&kp LS(GRAVE)  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)     &kp LS(N4)     &kp LS(LBKT)    &kp LS(RBKT)       &none      &none     &none      &none    &none
&kp LSHFT      &kp LS(N5)  &kp LS(N6)  &kp LS(N7)     &kp LS(N8)     &none           &kp LS(BACKSLASH)  &none      &kp UP    &none      &none    &none
&kp LCTRL      &kp LS(N9)  &kp LS(N0)  &kp LS(MINUS)  &kp LS(EQUAL)  &none           &none              &kp LEFT   &kp DOWN  &kp RIGHT  &none    &none
                                       &kp ENTER      &kp LEFT_ALT   &kp LEFT_WIN    &trans             &kp SPACE
                                                      &kp LCTRL      &kp INS         &kp DELETE
            >;
        };

        Mouse {
            bindings = <
&none        &none         &none         &none         &none      &none         &none           &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR      &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none           &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &mo 4         &mkp LCLK  &none         &studio_unlock  &mkp LCLK  &mo 4         &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK       &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        Scroll {
            bindings = <
&none        &none         &none         &none         &none      &none         &none       &none      &none         &none         &none         &none
&none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none      &bt BT_CLR    &bt BT_CLR  &none      &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &none
&none        &none         &none         &mkp MCLK     &none      &none         &none       &none      &mkp MCLK     &none         &none         &none
&bootloader  &none         &mkp RCLK     &none         &mkp LCLK  &none         &none       &mkp LCLK  &none         &mkp RCLK     &none         &bootloader
                                         &none         &mkp LCLK  &mkp RCLK     &mkp RCLK   &mkp LCLK
                                                       &none      &none         &none
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans
                                &trans  &trans    &trans
            >;
        };
    };
};
